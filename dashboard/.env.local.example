# ==============================================================================
# OpenDX-Lab Dashboard - Environment Variables
# Copy to .env.local and configure for your deployment
# ==============================================================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-me
AUTH_TRUST_HOST=true

# Keycloak OIDC Provider
KEYCLOAK_CLIENT_ID=opendx-dashboard
KEYCLOAK_CLIENT_SECRET=dashboard-client-secret-change-me
KEYCLOAK_ISSUER=http://localhost:8080/realms/opendx

# Database (Prisma) - uses Docker service hostname
DATABASE_URL=postgresql://opendx_admin:secure_postgres_pass_123@postgres:5432/dashboard_db

# n8n Webhook URLs (for employee onboarding/offboarding)
N8N_ONBOARDING_WEBHOOK_URL=http://n8n:5678/webhook/onboarding
N8N_OFFBOARDING_WEBHOOK_URL=http://n8n:5678/webhook/offboarding

# Service URLs (internal Docker hostnames for health checks)
KEYCLOAK_URL=http://keycloak:8080
MATTERMOST_URL=http://mattermost:8065
WIKIJS_URL=http://wikijs:3000
N8N_URL=http://n8n:5678
METABASE_URL=http://metabase:3000
OLLAMA_URL=http://ollama:11434
